# Copy this file to .dev.vars for local Wrangler development. Do not commit .dev.vars.
# Generate a unique long random value for every environment.
JWT_SECRET=replace-with-a-long-random-secret

# ALLOWED_ORIGIN is configured as a non-secret Wrangler variable in wrangler.toml.
# For deployed environments, set JWT_SECRET with: wrangler secret put JWT_SECRET
